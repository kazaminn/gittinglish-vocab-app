{
  "name": "gittinglish-vocab-app",
  "version": "1.0.0",
  "description": "Git英語学習ドリル（公開版・GitVerbs85）",
  "private": true,
  "type": "module",
  "author": "kazaminn",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "pnpm -C web dev",
    "dev:api": "pnpm -C server dev",
    "build": "pnpm -C shared build && pnpm -C web build",
    "test": "pnpm -C server test && pnpm -C web test",
    "typecheck": "pnpm -C shared exec tsc --noEmit && pnpm -C server exec tsc --noEmit && pnpm -C web exec tsc --noEmit",
    "lint": "pnpm -C web lint:strict",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "prepare": "husky",
    "precommit": "lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.9.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}